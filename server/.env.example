# ── Ambiente ──────────────────────────────────────────────
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
# debug | info | warn | error
LOG_LEVEL=info
# Fuso usado na data/hora dos logs
TZ=America/Araguaina

# ── Banco interno do DBHub (Postgres do Railway) ─────────
# Em produção no Railway use a referência: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:senha@localhost:5432/dbhub

# ── Segurança ─────────────────────────────────────────────
# Segredo de 32+ caracteres que criptografa as URLs dos bancos salvos (não troque depois de usar!)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Segredo para assinar o cookie de sessão (mín. 32 caracteres)
SESSION_SECRET=
# Validade da sessão em horas
SESSION_TTL_HOURS=168

# Chave para entrar no painel (16+ caracteres). Se ficar vazia, o DBHub gera uma
# no primeiro boot e mostra no log. Trocar a chave encerra as sessões abertas.
DBHUB_ACCESS_KEY=

# Origem do front em dev (em produção o server serve o front)
CORS_ORIGIN=http://localhost:5173

# ── Bancos externos ───────────────────────────────────────
# Tempo máximo de uma query (ms) e limite de linhas retornadas
QUERY_TIMEOUT_MS=30000
QUERY_MAX_ROWS=1000
# Fecha o pool de um banco externo após X ms sem uso
POOL_IDLE_TTL_MS=600000
